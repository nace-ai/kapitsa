{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nace-ai/kapitsa/blob/main/schema/control/error.schema.json",
  "title": "Every non-2xx response body",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "control.schema.json#/$defs/error_code"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "for people; clients branch on code"},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {"type": "string", "description": "unknown_field, invalid_value: the request field"},
            "run_id": {"$ref": "control.schema.json#/$defs/run_id", "description": "run_id_mismatch: the run that holds the socket"},
            "retry_after_s": {"type": "integer", "minimum": 1, "description": "busy: the Retry-After header's value"},
            "model": {"type": "string", "description": "model_not_found: the name asked for"}
          }
        }
      }
    }
  }
}
