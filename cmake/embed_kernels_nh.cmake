# Concatenates src/kernels/common.h + src/kernels/nemotron/*.h + *.metal into one C++ string literal: the
# Nemotron-H kernels, a library of their own compiled when a Nemotron model loads (Gpu::compile_extra).
file(READ ${SRC_DIR}/common.h COMMON)
file(GLOB HEADERS ${SRC_DIR}/nemotron/*.h)
list(SORT HEADERS)
set(ALL "${COMMON}\n")
foreach(h ${HEADERS})
  file(READ ${h} BODY)
  get_filename_component(n ${h} NAME)
  string(APPEND ALL "\n// ---- nemotron/${n} ----\n${BODY}\n")
endforeach()
file(GLOB METALS ${SRC_DIR}/nemotron/*.metal)
list(SORT METALS)
foreach(m ${METALS})
  file(READ ${m} BODY)
  string(REGEX REPLACE "#include \"[a-z_]+\\.h\"" "" BODY "${BODY}")
  get_filename_component(n ${m} NAME)
  string(APPEND ALL "\n// ---- nemotron/${n} ----\n${BODY}\n")
endforeach()
file(WRITE ${OUT} "// generated\nnamespace ni { extern const char* const kNhKernelSource; const char* const kNhKernelSource = R\"NIKERNEL(${ALL})NIKERNEL\"; }\n")
