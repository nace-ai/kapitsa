# Concatenates src/kernels/common.h + src/kernels/inkling2/*.metal into one C++ string literal:
# Inkling-2 kernels compiled once lazily via Gpu::compile_extra("Ink2", kInk2KernelSource).
file(READ ${SRC_DIR}/common.h COMMON)
file(READ ${SRC_DIR}/inkling2/gguf_blocks.h GGUF_BLOCKS)
file(READ ${SRC_DIR}/../gguf/iq_grids.h IQ_GRIDS)
set(IQ2 "")
foreach(TABLE "kIq2xxs\\[256\\]" "kIq2xs\\[512\\]")
  string(REGEX MATCH "inline constexpr uint64_t ${TABLE} = \\{[^}]+\\};" GRID "${IQ_GRIDS}")
  if(NOT GRID)
    message(FATAL_ERROR "Inkling2: ${TABLE} codebook not found")
  endif()
  string(REPLACE "inline constexpr uint64_t" "constant ulong" GRID "${GRID}")
  string(APPEND IQ2 "${GRID}\n")
endforeach()
string(REGEX MATCH "inline constexpr uint32_t kIq3xxs\\[256\\] = \\{[^}]+\\};" IQ3 "${IQ_GRIDS}")
if(NOT IQ3)
  message(FATAL_ERROR "Inkling2: IQ3_XXS codebook not found")
endif()
string(REPLACE "inline constexpr uint32_t" "constant uint" IQ3 "${IQ3}")
set(ALL "${COMMON}\nnamespace ink2_gguf {\n${IQ2}\n${IQ3}\n}\n${GGUF_BLOCKS}\n")
file(GLOB METALS ${SRC_DIR}/inkling2/*.metal)
list(SORT METALS)
foreach(m ${METALS})
  file(READ ${m} BODY)
  string(REGEX REPLACE "#include \"[a-z_]+\\.h\"" "" BODY "${BODY}")
  get_filename_component(n ${m} NAME)
  string(APPEND ALL "\n// ---- inkling2/${n} ----\n${BODY}\n")
endforeach()
file(WRITE ${OUT} "// generated\nnamespace ni { extern const char* const kInk2KernelSource; const char* const kInk2KernelSource = R\"NIKERNEL(${ALL})NIKERNEL\"; }\n")
