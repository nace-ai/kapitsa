   {"write_json": {"path": "{state}/omlx/q36-35b-best/base/model_settings.json",
                   "data": {"version": 1, "models": {"qwen3.6-35b-a3b-4bit": {
                     "dflash_enabled": true, "dflash_draft_model": "{models}/drafters/Qwen3.6-35B-A3B-DFlash2",
                     "dflash_draft_quant_enabled": true, "dflash_draft_quant_weight_bits": 4, "dflash_draft_quant_group_size": 64,
