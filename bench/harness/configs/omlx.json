   {"clean_dir": "{state}/omlx/q36-35b-best/base/kv-cache"}
  ],
  "cmd": ["{env:OMLX_BIN=omlx}", "serve", "--model-dir", "{state}/omlx/q36-35b-best/models", "--no-hf-cache",
          "--headless", "--host", "127.0.0.1", "--port", "8141", "--base-path", "{state}/omlx/q36-35b-best/base",
          "--paged-ssd-cache-dir", "{state}/omlx/q36-35b-best/base/kv-cache", "--paged-ssd-cache-max-size", "4GB",
          "--hot-cache-max-size", "4GB", "--memory-guard", "aggressive"],
  "env": {"HF_HUB_OFFLINE": "1"},
  "env_clear_prefixes": ["OMLX_"],
  "base_url": "http://127.0.0.1:8141/v1",
  "model": "qwen3.6-35b-a3b-4bit",
  "ready_timeout": 300,
  "adaptive_warm": true,
  "requires_paths": ["{models}/qwen3.6-35b-a3b-4bit/model.safetensors.index.json",
                     "{models}/drafters/Qwen3.6-35B-A3B-DFlash2/model.safetensors"],
  "log_grep": ["MTP\\[|Lightning MTP|Speculative backend|MTP path|parked", "DFlash|drafter", "memory|guard",
               "[Ll]oaded model|Discovered model", "[Ee]rror|Traceback|WARNING"],
  "note": "oMLX's fastest setting measured on this model: DFlash2 speculative decoding inside its batched engine with the same incoai drafter Kapitsa uses, quantized to 4-bit g64 at load, block 5 (the DFlash2 authors' oMLX recipe), verify mode 'adaptive' (oMLX's default; it beat 'dflash' on this mixture of experts, where each extra verified row reads more experts). Smoke tests before the run (median of 11 short decodes): this setting 131 tok/s, verify 'dflash' 117, Lightning MTP 123. The model directory is a link to the same weights the other MLX engines read; its MTP side-car is not indexed there, so no MTP head is attached. The SSD KV cache is emptied before each run; memory guard 'aggressive' (with 'balanced', oMLX refused the 27B's 16K prompt in an earlier run)."
 },
