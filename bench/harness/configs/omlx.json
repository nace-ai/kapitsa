   {"clean_dir": "{state}/omlx/q36-35b-best/base/kv-cache"}
  ],
  "cmd": ["{env:OMLX_BIN=omlx}", "serve", "--model-dir", "{state}/omlx/q36-35b-best/models", "--no-hf-cache",
