[
 {
  "label": "bolt-kapitsa",
  "display": "Kapitsa (LiLiCorr drafter, GPU + Neural Engine prefill)",
  "engine": "kapitsa",
  "version": "auto",
  "model_name": "Nemotron-3.5-Bolt-74B-A9B-24GB",
  "model_path": "{models}/nemotron-3.5-bolt-24gb",
  "cmd": ["{env:KAPITSA_BIN={first:{repo}/build/kapitsa|kapitsa}}", "serve",
          "--model", "{models}/nemotron-3.5-bolt-24gb", "--model-id", "bolt",
          "--host", "127.0.0.1", "--port", "8250", "--ctx", "32768", "--slots", "1"],
  "env_clear_prefixes": ["NI_", "KAPITSA_"],
  "base_url": "http://127.0.0.1:8250/v1",
  "model": "bolt",
  "requires_paths": ["{models}/nemotron-3.5-bolt-24gb/model.safetensors.index.json",
                     "{models}/nemotron-3.5-bolt-24gb/dflash/model.safetensors"],
  "bench_args": ["--ref-prompt-tokens", "4000:4183,16000:16514"],
  "note": "Kapitsa's default settings on NVIDIA's own 24 GB checkpoint, read as stored (NVFP4 Mamba projections, IQ2_XXS experts, Q8_0 attention / latent / LM head, BF16 embedding and router), with NVIDIA's LiLiCorr drafter from the folder's dflash/ (exact verification at every temperature). Prefill splits the Mamba projections and the shared expert between the GPU and the Neural Engine; the server compiles the Neural Engine program in the background after start (prefill runs on the GPU until then; the warm-up and the decode phases come first). --slots 1 for parity with the others' single sequence."
 },
 {
  "label": "bolt-omlx-lilicorr",
  "display": "oMLX + LiLiCorr drafter (the bundle's model file)",
  "engine": "omlx",
  "version": "auto",
  "model_name": "Nemotron-3.5-Bolt-74B-A9B-24GB",
  "model_path": "{models}/nemotron-3.5-bolt-24gb",
  "prepare": [
   {"symlink": {"src": "{models}/nemotron-3.5-bolt-24gb", "dst": "{state}/omlx/bolt/models/nemotron-3.5-bolt-24gb"}},
   {"write_json": {"path": "{state}/omlx/bolt/base-lilicorr/model_settings.json",
                   "data": {"version": 1, "models": {"nemotron-3.5-bolt-24gb": {"trust_remote_code": true, "dflash_enabled": true}}}}},
   {"clean_dir": "{state}/omlx/bolt/base-lilicorr/kv-cache"}
  ],
  "cmd": ["{harness}/launchers/omlx_bolt_serve.sh", "8241", "18241", "nemotron-3.5-bolt-24gb",
          "--model-dir", "{state}/omlx/bolt/models", "--no-hf-cache", "--headless",
          "--base-path", "{state}/omlx/bolt/base-lilicorr",
          "--paged-ssd-cache-dir", "{state}/omlx/bolt/base-lilicorr/kv-cache", "--paged-ssd-cache-max-size", "4GB",
          "--hot-cache-max-size", "4GB", "--memory-guard", "aggressive"],
  "env": {"HF_HUB_OFFLINE": "1"},
  "env_clear_prefixes": ["OMLX_"],
  "base_url": "http://127.0.0.1:8241/v1",
  "model": "nemotron-3.5-bolt-24gb",
  "ready_timeout": 900,
  "requires_paths": ["{models}/nemotron-3.5-bolt-24gb/model.safetensors.index.json",
                     "{models}/nemotron-3.5-bolt-24gb/nemotron_bolt.py",
                     "{models}/nemotron-3.5-bolt-24gb/dflash/model.safetensors"],
  "log_grep": ["### |DFlash|drafter|LiLiCorr|dflash", "memory|guard", "[Ll]oaded model|Discovered model|remote code",
               "[Ee]rror|Traceback|WARNING"],
  "bench_args": ["--ref-prompt-tokens", "4000:4183,16000:16514"],
  "note": "The checkpoint folder must also hold the MLX model file of NVIDIA's Bolt bundle for MLX (nemotron_bolt.py; Trust Remote Code). The launcher follows that bundle's README: load, unload, load again with DFlash, then open the harness port. In oMLX 0.7.1rc1 every T > 0 request with the drafter fails (its sampled DFlash selection), so this configuration measures only greedy; bolt-omlx-lilicorr-greedy sends temperature 0 in every phase."
 },
 {
  "label": "bolt-omlx-lilicorr-greedy",
  "extends": "bolt-omlx-lilicorr",
  "display": "oMLX + LiLiCorr drafter, every request greedy",
  "bench_args": ["--ref-prompt-tokens", "4000:4183,16000:16514", "--temperature", "0"]
 },
 {
  "label": "bolt-omlx",
  "display": "oMLX (the bundle's model file, no drafter)",
  "engine": "omlx",
  "version": "auto",
  "model_name": "Nemotron-3.5-Bolt-74B-A9B-24GB",
  "model_path": "{models}/nemotron-3.5-bolt-24gb",
  "prepare": [
   {"symlink": {"src": "{models}/nemotron-3.5-bolt-24gb", "dst": "{state}/omlx/bolt/models/nemotron-3.5-bolt-24gb"}},
   {"write_json": {"path": "{state}/omlx/bolt/base-plain/model_settings.json",
                   "data": {"version": 1, "models": {"nemotron-3.5-bolt-24gb": {"trust_remote_code": true, "dflash_enabled": false}}}}},
   {"clean_dir": "{state}/omlx/bolt/base-plain/kv-cache"}
  ],
  "cmd": ["{env:OMLX_BIN=omlx}", "serve", "--model-dir", "{state}/omlx/bolt/models", "--no-hf-cache", "--headless",
          "--host", "127.0.0.1", "--port", "8242", "--base-path", "{state}/omlx/bolt/base-plain",
          "--paged-ssd-cache-dir", "{state}/omlx/bolt/base-plain/kv-cache", "--paged-ssd-cache-max-size", "4GB",
          "--hot-cache-max-size", "4GB", "--memory-guard", "aggressive"],
  "env": {"HF_HUB_OFFLINE": "1"},
  "env_clear_prefixes": ["OMLX_"],
  "base_url": "http://127.0.0.1:8242/v1",
  "model": "nemotron-3.5-bolt-24gb",
  "ready_timeout": 600,
  "requires_paths": ["{models}/nemotron-3.5-bolt-24gb/model.safetensors.index.json",
                     "{models}/nemotron-3.5-bolt-24gb/nemotron_bolt.py"],
  "log_grep": ["DFlash|drafter|LiLiCorr|dflash", "memory|guard", "[Ll]oaded model|Discovered model|remote code",
               "[Ee]rror|Traceback|WARNING"],
  "bench_args": ["--ref-prompt-tokens", "4000:4183,16000:16514"],
  "note": "oMLX with the bundle's MLX model file (Trust Remote Code), no speculative decoding; cache flags as in omlx.json."
 },
 {
  "label": "bolt-mlxvlm",
  "display": "mlx-vlm server (the bundle's model file, no drafter)",
  "engine": "mlx-lm",
  "version": "auto",
  "model_name": "Nemotron-3.5-Bolt-74B-A9B-24GB",
  "model_path": "{models}/nemotron-3.5-bolt-24gb",
  "cmd": ["{env:MLX_VLM_PYTHON=python3}", "-m", "mlx_vlm.server", "--model", "{models}/nemotron-3.5-bolt-24gb",
          "--trust-remote-code", "--host", "127.0.0.1", "--port", "8243"],
  "env": {"HF_HUB_OFFLINE": "1"},
  "base_url": "http://127.0.0.1:8243/v1",
  "model": "{models}/nemotron-3.5-bolt-24gb",
  "ready_timeout": 600,
  "requires_paths": ["{models}/nemotron-3.5-bolt-24gb/model.safetensors.index.json",
                     "{models}/nemotron-3.5-bolt-24gb/nemotron_bolt.py"],
  "log_grep": ["[Ll]oad|model", "[Ee]rror|Traceback|WARNING"],
  "bench_args": ["--ref-prompt-tokens", "4000:4183,16000:16514"],
  "note": "The bundle's second host: mlx-vlm with Trust Remote Code (MLX_VLM_PYTHON = a Python with mlx-vlm 0.7.8), no speculative decoding (the bundle: speculative decoding is for oMLX only). The request's model id is the path the server was started with."
 }
]
