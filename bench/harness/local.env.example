# Copy to local.env (git-ignored) and adjust. compare_engines.py and bench.py read it; variables already set in
# the environment win. Leave a line out (or commented) to use the default shown.

# Weights folder (README.md, "Weights"): qwen3.6-35b-a3b-4bit/, qwen3.8-27b-4bit-mtp/, drafters/, ...
#BENCH_MODELS=~/models
# Results, server logs and engine state of your runs (default: runs/ next to this file)
#BENCH_OUT=~/kapitsa-bench-runs
# The GPU lock every GPU job on this Mac must share (`lockf -k <file> <cmd>` for anything that is not this harness)
#BENCH_GPU_LOCK=~/.cache/nace-gpu.lock
# Apps whose GPU use is ambient for every engine, e.g. the terminal or desktop app you run the benchmark from
#BENCH_GPU_AMBIENT=Terminal,iTerm2

# Engines (default: found on PATH)
#KAPITSA_BIN=~/src/kapitsa/build/kapitsa       # default: this checkout's build/kapitsa, else `kapitsa`
#LLAMA_SERVER=~/llama.cpp/llama-b11669/llama-server
#OLLAMA_BIN=/Applications/Ollama.app/Contents/Resources/ollama
#OLLAMA_MODELS=~/.ollama/models                 # the store the GGUF tags were pulled into
#OLLAMA_MLX_MODELS=~/models/ollama-mlx          # the store tools/ollama_mlx_import.py wrote into
#MLX_LM_SERVER=~/venvs/mlx-lm/bin/mlx_lm.server
#OMLX_BIN=~/venvs/omlx/bin/omlx
#MTPLX_BIN=~/venvs/mtplx/bin/mtplx
#LMS_BIN=~/.lmstudio/bin/lms

# GGUF files for llama.cpp, if not read from the Ollama store
#QWEN36_35B_GGUF=~/models/gguf/qwen3.6-35b-a3b-mtp-q4_K_M.gguf
#QWEN38_27B_GGUF=~/models/gguf/qwen3.8-27b-mtp-q4_K_M.gguf
