  "content": "```python\n\"\"\"\nAsyncio Job Scheduler with Bounded Concurrency, Priority Queue, and Advanced Features.\n\nThis module provides a robust, production-ready asynchronous job scheduler capable of handling:\n- Bounded concurrency (max concurrent tasks).\n- Priority-based scheduling (heap-based).\n- Per-job deadlines (cancellation if deadline exceeded).\n- Retry logic with exponential backoff.\n- Graceful shutdown (draining pending tasks).\n- Comprehensive metrics and logging.\n\nAuthor: AI Assistant\n\"\"\"\n\nimport asyncio\nimport logging\nimport math\nimport time\nimport uuid\nfrom dataclasses import dataclass, field\nfrom enum import Enum\nfrom typing import Any, Callable, Dict, List, Optional, Tuple, TypeVar, Union\nfrom collections import deque\nfrom heapq import heappush, heappop\n\nimport aiohttp\nfrom aiohttp import ClientTimeout\n\n# Configure logging\nlogger = logging.getLogger(__name__)\n\n\n# ==============================================================================\n# Type Definitions\n# ==============================================================================\n\nT = TypeVar('T')\nR = TypeVar('R')\n\n# Job Status Enum\nclass JobStatus(Enum):\n    PENDING = \"pending\"\n    QUEUED = \"queued\"\n    RUNNING = \"running\"\n    COMPLETED = \"completed\"\n    FAILED = \"failed\"\n    CANCELLED = \"cancelled\"\n    RETRYING = \"retrying\"\n    TIMEOUT = \"timeout\"\n\n\n# ==============================================================================\n# Data Classes\n# ==============================================================================\n\n@dataclass\nclass JobConfig:\n    \"\"\"Configuration for a single job.\"\"\"\n    func: Callable[..., R]\n    args: tuple = field(default_factory=tuple)\n    kwargs: dict = field(default_factory=dict)\n    priority: int = 0  # Higher is more important\n    max_retries: int = 3\n    timeout: Optional[float] = None  # Seconds\n    deadline: Optional[float] = None  # Absolute timestamp (seconds since epoch)\n    retry_delay_base: float = 1.0  # Base seconds for exponential backoff\n    retry_multiplier: float = 2.0  # Multiplier for exponential backoff\n    metadata: dict = field(default_factory=dict)\n    \n    # Internal tracking\n    _retry_count: int = 0\n    _created_at: float = field(default_factory=time.time)\n    _last_retry_at: float = 0.0\n    \n    def __post_init__(self):",
