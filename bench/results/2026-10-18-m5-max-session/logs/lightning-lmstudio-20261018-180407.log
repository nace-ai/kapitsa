[model]         """Check if the item has exceeded its TTL."""
[model]         return time.monotonic() - self.created_at > self.ttl
[model]     
[model]     def time_until_expiry(self) -> float:
[model]         """Return seconds remaining until expiry."""
[model]         elapsed = time.monotonic() - self.created_at
[model]         remaining = self.ttl - elapsed
[model]         return max(0.0, remaining)
