  {
    "label": "q35-9b-llamacpp",
    "display": "llama.cpp (unsloth Q4_K_M GGUF)",
    "engine": "llama.cpp",
    "version": "auto",
    "model_name": "Qwen3.5-9B",
    "model_path": "{models}/gguf/Qwen3.5-9B-Q4_K_M.gguf",
    "cmd": [
      "{env:LLAMA_SERVER}",
      "-m",
      "{models}/gguf/Qwen3.5-9B-Q4_K_M.gguf",
      "-a",
      "qwen3.5-9b",
      "--host",
      "127.0.0.1",
      "--port",
      "8083",
      "-c",
      "32768",
      "-np",
      "1",
      "-ngl",
      "999",
      "-fa",
      "on",
      "-b",
      "2048",
      "-ub",
      "2048",
      "-lm",
      "none",
      "--jinja",
      "--reasoning-format",
      "deepseek",
      "--cache-ram",
      "8192",
      "--chat-template-file",
      "{models}/qwen3.5-9b-4bit/chat_template.jinja",
      "--ctx-checkpoints",
      "32",
      "--temp",
      "0.6",
      "--top-p",
      "0.95",
      "--top-k",
      "20",
      "--min-p",
      "0",
      "--no-webui"
    ],
    "env": {
      "GGML_METAL_RESIDENCY_KEEP_ALIVE_S": "3600"
    },
    "env_clear_prefixes": [
      "LLAMA_ARG_"
    ],
    "base_url": "http://127.0.0.1:8083/v1",
    "model": "qwen3.5-9b",
    "flag_check": "llama-server",
    "requires_paths": [
      "{models}/gguf/Qwen3.5-9B-Q4_K_M.gguf",
      "{models}/qwen3.5-9b-4bit/chat_template.jinja"
    ],
    "note": "M3 Pro 36 GB: unsloth/Qwen3.5-9B-GGUF Q4_K_M (no MTP head in it), the catalog 9B's chat template, the harness's llama.cpp settings."
  },
