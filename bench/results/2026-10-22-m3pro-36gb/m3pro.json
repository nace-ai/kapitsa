[
  {
    "label": "sw-q35-4b-kapitsa",
    "display": "Kapitsa (catalog 4b)",
    "engine": "kapitsa",
    "version": "auto",
    "model_name": "Qwen3.5-4B",
    "model_path": "~/.cache/kapitsa/models/qwen3.5-4b-4bit",
    "cmd": [
      "{env:KAPITSA_BIN}",
      "serve",
      "--model",
      "4b",
      "--model-id",
      "qwen3.5-4b",
      "--host",
      "127.0.0.1",
      "--port",
      "8091",
      "--ctx",
      "32768",
      "--slots",
      "1"
    ],
    "env": {
      "NI_DISK_CACHE_DIR": "{state}/kapitsa/prefix-cache"
    },
    "prepare": [
      {
        "clean_dir": "{state}/kapitsa/prefix-cache"
      }
    ],
    "cleanup": [
      {
        "clean_dir": "{state}/kapitsa/prefix-cache"
      }
    ],
    "env_clear_prefixes": [
      "NI_",
      "KAPITSA_"
    ],
    "base_url": "http://127.0.0.1:8091/v1",
    "model": "qwen3.5-4b",
    "note": "M3 Pro 36 GB sweep: Kapitsa built from main on the M3 (the commit is in each record; the first 4B and 27B runs used the 0.2.8 release, daf6e95), as the catalog ships the model, with its default decoding."
