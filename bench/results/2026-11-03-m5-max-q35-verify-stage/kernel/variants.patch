+  nhf_h8 v;
+  _Pragma("clang loop unroll(full)")
+  for (short i = 0; i < 2; ++i) {
+    const half4 x = *(const threadgroup half4*)(base + (r0 + fm + 8 * i) * 256 + c0 + fn);
+    v[4 * i] = x.x;
+    v[4 * i + 1] = x.y;
+    v[4 * i + 2] = x.z;
+    v[4 * i + 3] = x.w;
+  }
+  return v;
+}
