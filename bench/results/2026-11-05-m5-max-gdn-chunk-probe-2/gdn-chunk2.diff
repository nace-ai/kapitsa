--- a/src/kernels/gdn.metal
+++ b/src/kernels/gdn.metal
@@ -536,3 +536,318 @@ struct RowsParams {
   }
   for (uint i = tid; i < p.D; i += ntg) Y[t * p.D + i] = half(p.norm ? x[i] * inv * float(w[i]) : x[i]);
