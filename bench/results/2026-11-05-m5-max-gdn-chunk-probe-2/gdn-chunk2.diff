diff --git a/tools/zz_gdn_tprobe.cpp b/tools/zz_gdn_tprobe.cpp
new file mode 100644
index 00000000..38c323c5
--- /dev/null
+++ b/tools/zz_gdn_tprobe.cpp
@@ -0,0 +1,33 @@
+// scratch probe (not for merge): times zz_gdn_tprobe (src/kernels/tensor/zz_gdn_tprobe.metal) for heads x 2 slices x
+// T/64 blocks. zz_gdn_tprobe [T=2048] [Hv=32]
+#include "metal/gpu.h"
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+using namespace ni;
+namespace ni { extern const char* const kTensorKernelSource; }
+int main(int argc, char** argv) {
+  const uint32_t T = argc > 1 ? atoi(argv[1]) : 2048, Hv = argc > 2 ? atoi(argv[2]) : 32, nblk = T / 64;
+  Gpu& g = Gpu::get();
+  g.compile_extra("tensor", kTensorKernelSource, true);
+  const uint32_t ntg = Hv * 2;
+  const size_t n = size_t(ntg) * nblk * 64 * 128;
+  Buffer W = g.alloc(n * 2), Q = g.alloc(n * 2), K = g.alloc(n * 2), out = g.alloc(ntg * 128 * 4);
+  std::mt19937 r(1);
+  for (size_t i = 0; i < n; ++i) {
+    W.as<uint16_t>()[i] = 0x2000 + (r() & 0x3ff);
+    Q.as<uint16_t>()[i] = 0x2000 + (r() & 0x3ff);
+    K.as<uint16_t>()[i] = 0x2000 + (r() & 0x3ff);
+  }
+  Pipeline p = g.pipeline("zz_gdn_tprobe");
+  double best = 1e9;
+  for (int t = 0; t < 8; ++t) {
+    auto e = g.begin();
+    e->use(p);
+    e->buf(0, W); e->buf(1, Q); e->buf(2, K); e->buf(3, out); e->val(4, nblk);
+    e->dispatch(ntg, 1, 1, 128);
+    e->commit_and_wait();
+    if (t) best = std::min(best, e->gpu_ms());
+  }
+  printf("T %u Hv %u: %u threadgroups x %u blocks: %.3f ms\n", T, Hv, ntg, nblk, best);
+}
