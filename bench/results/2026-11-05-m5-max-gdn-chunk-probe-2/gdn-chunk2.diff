--- /dev/null
+++ b/src/kernels/tensor/zz_gdn_tprobe.metal
@@ -0,0 +1,77 @@
+// scratch probe (not for merge): the matrix work of a chunked DeltaNet scan on the tensor units, half inputs, fp32
+// accumulators. One threadgroup per (head, 64-row dv slice), 4 simdgroups each one 32 x 32 output tile; per 64-token
+// block: U = W S^T (64 x 64 x 128), Y = Q S^T (64 x 64 x 128), U to threadgroup memory as half, S += U^T K
+// (64 x 128 x 64, two 32 x 32 tiles a simdgroup over 4 x 32 columns), S kept as half in threadgroup memory.
+#include "common.h"
+#include <metal_tensor>
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+
+[[kernel, max_total_threads_per_threadgroup(128)]] void zz_gdn_tprobe(
+    const device half* W [[buffer(0)]], const device half* Q [[buffer(1)]], const device half* K [[buffer(2)]],
+    device float* out [[buffer(3)]], constant uint& nblk [[buffer(4)]], uint tg [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+  constexpr int C = 64, D = 128, SV = 64;
+  threadgroup half S[SV * D];   // 16 KB
+  threadgroup half Ut[C * SV];  // 8 KB, [t][dv]
+  for (uint e = tid; e < SV * D; e += 128) S[e] = half(0.001f * float(e % 7));
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  typedef tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline> tg_t;
+  typedef tensor<device half, dextents<int32_t, 2>, tensor_inline> dv_t;
+  constexpr auto dT = matmul2d_descriptor(32, 32, 32, false, true, false, matmul2d_descriptor::mode::multiply_accumulate);
+  constexpr auto dN = matmul2d_descriptor(32, 32, 32, true, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<dT, execution_simdgroup> opT;
+  matmul2d<dN, execution_simdgroup> opN;
+  const uint tr = sg / 2, tc = sg % 2;
+  auto tS = tg_t(S, dextents<int32_t, 2>(D, SV));    // [dv][d]: rows dv, columns d
+  auto tU = tg_t(Ut, dextents<int32_t, 2>(SV, C));   // [t][dv]
+  float sink = 0.0f;
+  for (uint b = 0; b < nblk; ++b) {
+    const size_t base = (size_t(tg) * nblk + b) * C * D;
+    auto tW = dv_t((device half*)W + base, dextents<int32_t, 2>(D, C));
+    auto tQ = dv_t((device half*)Q + base, dextents<int32_t, 2>(D, C));
+    auto tK = dv_t((device half*)K + base, dextents<int32_t, 2>(D, C));
+    auto w0 = tW.template slice<32, 32>(0, 0);
+    auto s0 = tS.template slice<32, 32>(0, 0);
+    auto u = opT.template get_destination_cooperative_tensor<decltype(w0), decltype(s0), float>();
+    auto y = opT.template get_destination_cooperative_tensor<decltype(w0), decltype(s0), float>();
+    for (uint16_t i = 0; i < u.get_capacity(); ++i) u[i] = 0.0f, y[i] = 0.0f;
+    for (int d0 = 0; d0 < D; d0 += 32) {
+      auto ws = tW.template slice<32, 32>(d0, int32_t(32 * tr));
+      auto qs = tQ.template slice<32, 32>(d0, int32_t(32 * tr));
+      auto ss = tS.template slice<32, 32>(d0, int32_t(32 * tc));
+      opT.run(ws, ss, u);
+      opT.run(qs, ss, y);
+    }
+    for (uint16_t i = 0; i < y.get_capacity(); ++i) sink += y[i];
+    for (uint16_t i = 0; i < u.get_capacity(); ++i) {
+      if (!u.is_valid_element(i)) continue;
+      const auto ix = u.get_multidimensional_index(i);
+      Ut[(32 * tr + ix[1]) * SV + 32 * tc + ix[0]] = half(u[i]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // S[dv][d] += sum_t U[t][dv] K[t][d]: this simdgroup's dv rows 32 * tr.., columns 64 * tc .. + 63 (two tiles)
+    auto ua = tU.template slice<32, 32>(int32_t(32 * tr), 0);
+    auto ka = tK.template slice<32, 32>(int32_t(64 * tc), 0);
+    auto s1 = opN.template get_destination_cooperative_tensor<decltype(ua), decltype(ka), float>();
+    auto s2 = opN.template get_destination_cooperative_tensor<decltype(ua), decltype(ka), float>();
+    for (uint16_t i = 0; i < s1.get_capacity(); ++i) s1[i] = 0.0f, s2[i] = 0.0f;
+    for (int t0 = 0; t0 < C; t0 += 32) {
+      auto us = tU.template slice<32, 32>(int32_t(32 * tr), t0);
+      auto k1 = tK.template slice<32, 32>(int32_t(64 * tc), t0);
+      auto k2 = tK.template slice<32, 32>(int32_t(64 * tc + 32), t0);
+      opN.run(us, k1, s1);
+      opN.run(us, k2, s2);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint16_t i = 0; i < s1.get_capacity(); ++i) {
+      if (!s1.is_valid_element(i)) continue;
+      const auto ix = s1.get_multidimensional_index(i);
+      const uint r = 32 * tr + ix[1], c = 64 * tc + ix[0];
+      S[r * D + c] = half(0.99f * float(S[r * D + c]) + s1[i]);
+      S[r * D + c + 32] = half(0.99f * float(S[r * D + c + 32]) + s2[i]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  out[tg * 128 + tid] = sink + float(S[tid]);
+}
