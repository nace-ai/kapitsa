+// xh2_ / hh2_ for a half of `rows` rows (at most the larger half of a chunk: tmax_ / 2 + 64 rows), made once
+void Qwen35::wave_scratch(int rows) {
+  if (xh2_ && xh2_.size >= size_t(rows) * (xh_.size / size_t(tmax_))) return;
+  const size_t n = size_t(tmax_) / 2 + 64;
+  xh2_ = Gpu::get().alloc(n * (xh_.size / size_t(tmax_)), "xh2");
+  hh2_ = Gpu::get().alloc(n * (hh_.size / size_t(tmax_)), "hh2");
+  owned_bufs_.push_back(xh2_);
+  owned_bufs_.push_back(hh2_);
+}
