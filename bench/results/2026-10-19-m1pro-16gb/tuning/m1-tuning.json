[
 {
  "label": "q35-4b-omlx-dflash-b4",
  "display": "oMLX + DFlash (z-lab drafter 4-bit, block 4, adaptive verify)",
  "extends": "q35-4b-omlx-best",
  "prepare": [
   {
    "symlink": {
     "src": "{models}/qwen3.5-4b-4bit-mtp",
     "dst": "{state}/omlx/q35-4b-omlx-dflash-b4/models/qwen3.5-4b-4bit"
    }
   },
   {
    "write_json": {
     "path": "{state}/omlx/q35-4b-omlx-dflash-b4/base/model_settings.json",
     "data": {
      "version": 1,
      "models": {
       "qwen3.5-4b-4bit": {
        "dflash_enabled": true,
        "dflash_draft_model": "{models}/drafters/Qwen3.5-4B-DFlash",
        "dflash_draft_quant_enabled": true,
        "dflash_draft_quant_weight_bits": 4,
        "dflash_draft_quant_group_size": 64,
        "dflash_block_size": 4,
        "dflash_verify_mode": "adaptive"
       }
      }
     }
    }
   },
   {
    "clean_dir": "{state}/omlx/q35-4b-omlx-dflash-b4/base/kv-cache"
   }
  ],
  "cmd": [
   "{env:OMLX_BIN=omlx}",
   "serve",
   "--model-dir",
   "{state}/omlx/q35-4b-omlx-dflash-b4/models",
   "--no-hf-cache",
   "--headless",
   "--host",
   "127.0.0.1",
   "--port",
   "8141",
   "--base-path",
   "{state}/omlx/q35-4b-omlx-dflash-b4/base",
   "--paged-ssd-cache-dir",
   "{state}/omlx/q35-4b-omlx-dflash-b4/base/kv-cache",
   "--paged-ssd-cache-max-size",
   "4GB",
   "--hot-cache-max-size",
   "4GB",
   "--memory-guard",
   "aggressive"
  ],
  "requires_paths": [
   "{models}/qwen3.5-4b-4bit-mtp/model.safetensors.index.json",
   "{models}/drafters/Qwen3.5-4B-DFlash/model.safetensors"
  ],
  "note": "M1 Pro tuning: oMLX's DFlash path with z-lab's 4B drafter on the 4-bit trunk."
 },
