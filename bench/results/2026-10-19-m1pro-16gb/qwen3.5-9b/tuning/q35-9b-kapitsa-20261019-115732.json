te time or duration\n    LRU = \"lru\"  # Sliding window (optional extension, currently implemented as TTL primarily)\n    LRU_TTL = \"lru_ttl\"  # Hybrid: LRU + TTL\n\n# ==============================================================================\n# CONFIGURATION CLASSES\n# ==============================================================================\n\nclass CacheConfig:\n    \"\"\"\n    Configuration for the cache.\n    \n    Attributes:\n        max_size: Maximum number of items the cache can hold.",
