   "text": "```python\n\"\"\"\nAdvanced LRU Cache with TTL Expiry and Thread Safety\n\nThis module provides a comprehensive implementation of a Least Recently Used (LRU) cache\nthat supports Time-To-Live (TTL) expiration. It includes a thread-safe wrapper for\nconcurrent access and a comprehensive pytest test suite to validate functionality.\n\nKey Features:\n- LRU eviction policy when capacity is exceeded\n- TTL-based expiration for entries\n- Thread-safe operations using locks and atomic operations\n- Support for custom key types and value types\n- Configuration options for capacity and default TTL\n- Comprehensive error handling and edge cases\n\nAuthor: Advanced Cache Implementation Team\nVersion: 1.0.0\nLicense: MIT\n\"\"\"\n\nimport threading\nimport time\nimport heapq\nfrom typing import (\n    Any,\n    Callable,\n    Dict,\n    Generic,\n    List,\n    Optional,\n    TypeVar,\n    Union,\n    cast,\n    TYPE_CHECKING,\n)\nimport pytest\nfrom collections import OrderedDict\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timedelta\nfrom enum import Enum\nimport copy\nimport sys\nimport traceback\n\n# Type variables for generic support\nK = TypeVar('K')\nV = TypeVar('V')\n\n# Constants for error codes\nclass CacheErrorCode(Enum):\n    \"\"\"Enumeration of possible cache error codes.\"\"\"\n    KEY_NOT_FOUND = \"key_not_found\"\n    VALUE_EXPIRED = \"value_expired\"\n    CAPACITY_EXCEEDED = \"capacity_exceeded\"\n    INVALID_OPERATION = \"invalid_operation\"\n    CONCURRENT_MODIFICATION = \"concurrent_modification\"\n    TIMEOUT = \"timeout\"\n\n# Custom exception classes\nclass CacheError(Exception):\n    \"\"\"Base exception for all cache-related errors.\"\"\"\n    def __init__(self, message: str, error_code: CacheErrorCode = CacheErrorCode.INVALID_OPERATION):\n        self.message",
