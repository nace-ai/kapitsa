   "text": "```python\n\"\"\"\nLRU Cache with TTL Expiry and Thread-Safe Wrapper.\n\nThis module implements a Least Recently Used (LRU) cache with support for\nTime-To-Live (TTL) expiry. It includes:\n1. A basic LRU cache implementation with TTL support\n2. A thread-safe wrapper using locks\n3. A comprehensive pytest test suite\n\nThe cache supports:\n- Setting and getting items with optional TTL\n- Automatic eviction of expired items\n- LRU eviction when capacity is exceeded\n- Thread-safe operations\n- Statistics tracking\n\"\"\"\n\nimport time\nimport threading\nfrom collections import OrderedDict\nfrom typing import Any, Optional, Callable, Dict, Tuple\nfrom dataclasses import dataclass, field\nfrom enum import Enum\nimport weakref\n\n\nclass CacheStatus(Enum):\n    \"\"\"Enumeration representing the status of a cache operation.\"\"\"\n    HIT = \"hit\"\n    MISS = \"miss\"\n    EXPIRED = \"expired\"\n    EVICTED = \"evicted\"\n    ERROR = \"error\"\n\n\n@dataclass\nclass CacheStats:\n    \"\"\"\n    Statistics for the cache.\n    \n    Attributes:\n        hits: Number of successful cache hits\n        misses: Number of cache misses\n        expirations: Number of items that expired\n        evictions: Number of items evicted due to capacity\n        total_sets: Total number of set operations\n        total_gets: Total number of get operations\n        total_deletes: Total number of delete operations\n        total_clears: Total number of clear operations\n    \"\"\"\n    hits: int = 0\n    misses: int = 0\n    expirations: int = 0\n    evictions: int = 0\n    total_sets: int = 0\n    total_gets: int = 0\n    total_deletes: int = 0\n    total_clears: int",
