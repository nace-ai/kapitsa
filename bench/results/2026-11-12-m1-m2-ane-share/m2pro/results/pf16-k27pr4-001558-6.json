   "text": "```python\n\"\"\"\nlru_cache_with_ttl.py\n\nA complete implementation of an LRU (Least Recently Used) cache with TTL (Time To Live)\nexpiry, a thread-safe wrapper, and a comprehensive pytest test suite.\n\nThis module provides:\n1. LRUCache: A basic LRU cache with TTL support.\n2. ThreadSafeLRUCache: A thread-safe wrapper around LRUCache.\n3. Comprehensive pytest test suite.\n\nFeatures:\n- LRU eviction policy\n- TTL-based expiry\n- Thread safety via locking\n- Configurable capacity\n- Statistics tracking\n- Context manager support\n\"\"\"\n\nimport time\nimport threading\nimport collections\nfrom typing import Any, Optional, Callable, Hashable\nfrom dataclasses import dataclass, field\nfrom enum import Enum\nimport pytest\n\n\nclass CacheStatus(Enum):\n    \"\"\"Enumeration for cache entry status.\"\"\"\n    ACTIVE = \"active\"\n    EXPIRED = \"expired\"\n    EVICTED = \"evicted\"\n\n\n@dataclass\nclass CacheEntry:\n    \"\"\"\n    Represents a single entry in the cache.\n    \n    Attributes:\n        key: The key for the cache entry.\n        value: The value stored in the cache.\n        created_at: Timestamp when the entry was created.\n        accessed_at: Timestamp when the entry was last accessed.\n        ttl: Time to live in seconds.\n        status: Current status of the entry.\n    \"\"\"\n    key: Hashable\n    value: Any\n    created_at: float\n    accessed_at: float\n    ttl: Optional[float]\n    status: CacheStatus = CacheStatus.ACTIVE\n\n    def is_expired(self, current_time: Optional[float] = None) -> bool:\n        \"\"\"\n        Check if the entry has expired.\n        \n        Args:\n            current_time: Current timestamp. If None, uses time.time().",
