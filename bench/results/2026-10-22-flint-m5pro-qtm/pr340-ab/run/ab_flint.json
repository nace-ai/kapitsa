[
 {
  "label": "flint-base",
  "display": "flint-base",
  "engine": "kapitsa",
  "version": "auto",
  "model_name": "Flint 40B-A2.5B",
  "model_path": "{models}/flint-4bit",
  "cmd": [
   "<base-repo>/build/kapitsa",
   "serve",
   "--model",
   "{models}/flint-4bit",
   "--model-id",
   "flint",
   "--host",
   "127.0.0.1",
   "--port",
   "8401",
   "--ctx",
   "32768",
   "--slots",
   "1"
  ],
  "env": {
   "NI_DISK_CACHE_DIR": "{state}/kapitsa/prefix-cache"
  },
  "prepare": [
   {
    "clean_dir": "{state}/kapitsa/prefix-cache"
   }
  ],
  "cleanup": [
   {
    "clean_dir": "{state}/kapitsa/prefix-cache"
   }
  ],
  "env_clear_prefixes": [
   "NI_",
   "KAPITSA_"
  ],
  "base_url": "http://127.0.0.1:8401/v1",
  "model": "flint",
  "requires_paths": [
   "{models}/flint-4bit/model-00004.safetensors"
  ],
  "bench_args": [
   "--temperature",
   "1.0",
   "--always-reasons",
   "--ref-prompt-tokens",
   "4000:3874,16000:15066"
  ],
  "agent_trace": "none",
  "note": "A/B flint-base"
 },
