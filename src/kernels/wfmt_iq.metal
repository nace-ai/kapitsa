// ---- decode helpers ----
struct IqSec {
  uint x1, x2, x3, d;  // byte offsets of the X1, X2, X3 and D sections
};

// IQ3_S: qh | scale << 8 of sub-block i (global index)
NI_INLINE uint iq3_e(const device uchar* W, IqSec s, uint i) {
  return uint(W[s.x2 + i]) | (extract_bits(uint(W[s.x3 + i / 2]), 4u * (i & 1u), 4) << 8);
}

// The 4 A pairs (e0, e4), (e1, e5), (e2, e6), (e3, e7) of one grid point, x 2^-24 with their signs: T = the magnitude
// bytes as (m0, m1, m4, m5), (m2, m3, m6, m7); s8 = the 8 signs (bit i: value i; bits past 7 are ignored).
NI_INLINE uint4 iq_pairs(uint2 T, uint s8) {
  // lo: s0 -> bit 15, s1 -> 23, s4 -> 31, s5 -> 7; hi: s2 -> 15, s3 -> 23, s6 -> 31, s7 -> 7 (one multiply each: the
  // shifted copies of the 4 bits only overlap at bits 27-28, whose carries stop at bit 29)
  const uint lo_m = ((s8 & 0x33u) * 0x08408004u) & 0x80808080u;
  const uint hi_m = (((s8 >> 2) & 0x33u) * 0x08408004u) & 0x80808080u;
  const uint lo = T.x ^ lo_m, hi = T.y ^ hi_m;
  const uint M = 0x807F807Fu;
  return uint4(lo & M, rotate(lo, 24u) & M, hi & M, rotate(hi, 24u) & M);
}

// IQ2_XXS's 8 signs: the 7 stored bits and their parity
NI_INLINE uint iq_s8(uint s7) { return s7 | (popcount(s7) << 7); }

// IQ3_S: two 4-value grid points (values 0-3, 4-7) as the permuted word pair
NI_INLINE uint2 iq3_T(uint g0, uint g1) { return uint2((g0 & 0xFFFFu) | (g1 << 16), (g0 >> 16) | (g1 & 0xFFFF0000u)); }

// d + the pairs (e_f, e_{f+4}) . (xa = x[0..3], xb = x[4..7])
NI_INLINE float iq_fma8p(uint4 p, float4 xa, float4 xb, float d) {
  const half2 w0 = as_type<half2>(p.x), w1 = as_type<half2>(p.y), w2 = as_type<half2>(p.z), w3 = as_type<half2>(p.w);
  d = fma(float(w0.x), xa.x, d);
  d = fma(float(w0.y), xb.x, d);
  d = fma(float(w1.x), xa.y, d);
  d = fma(float(w1.y), xb.y, d);
  d = fma(float(w2.x), xa.z, d);
  d = fma(float(w2.y), xb.z, d);
  d = fma(float(w3.x), xa.w, d);
  d = fma(float(w3.y), xb.w, d);
  return d;
}

// (2s + 1) 2^-24 (the subnormal half 2s + 1, as nh_x2_sub)
NI_INLINE float iq_sub(uint s) { return float(as_type<half>(ushort(2u * s + 1u))); }

// One sub-block of IQ2_S (q: index low bytes, sign bytes; e: qh | scales << 8) . xv[0..7]: x 2^-48 * 8 of the values'
// dot without d (as nh_x2_sub * nh_x2_dot32 for IQ2_XXS)
NI_INLINE float iq2s_dot32(uint2 q, uint e, thread const float4* xv) {
  constant uint2* gt = (constant uint2*)iq2s_gridp;
  float d0 = iq_fma8p(iq_pairs(gt[(q.x & 0xFFu) | ((e << 8) & 0x300u)], q.y), xv[0], xv[1], 0.0f);
  d0 = iq_fma8p(iq_pairs(gt[extract_bits(q.x, 8, 8) | ((e << 6) & 0x300u)], q.y >> 8), xv[2], xv[3], d0);
  float d1 = iq_fma8p(iq_pairs(gt[extract_bits(q.x, 16, 8) | ((e << 4) & 0x300u)], q.y >> 16), xv[4], xv[5], 0.0f);
  d1 = iq_fma8p(iq_pairs(gt[(q.x >> 24) | ((e << 2) & 0x300u)], q.y >> 24), xv[6], xv[7], d1);
  return fma(iq_sub(extract_bits(e, 8, 4)), d0, iq_sub(extract_bits(e, 12, 4)) * d1);
}

// One sub-block of IQ3_S (q: 8 index low bytes, sg: 32 signs, e: qh | scale << 8) . xv[0..7], x 2^-48 without d.
// Grid point p (values 4p .. 4p + 3): index byte p | qh bit p << 8.
NI_INLINE float iq3s_dot32(uint2 q, uint sg, uint e, thread const float4* xv) {
  float d = 0.0f;
  _Pragma("clang loop unroll(full)")
  for (int l = 0; l < 4; ++l) {
    const uint w = l < 2 ? q.x : q.y, sh = 16u * uint(l & 1);
    const uint g0 = iq3s_grid[extract_bits(w, sh, 8) | ((e << (8 - 2 * l)) & 256u)];
    const uint g1 = iq3s_grid[extract_bits(w, sh + 8, 8) | ((e << (7 - 2 * l)) & 256u)];
    d = iq_fma8p(iq_pairs(iq3_T(g0, g1), sg >> (8 * l)), xv[2 * l], xv[2 * l + 1], d);
  }
  return iq_sub(extract_bits(e, 8, 4)) * d;
}

// FMT's results x this = the dot product (weights and sub-block scales as subnormals; IQ2 scales are (2s + 1) / 8)
template <int FMT>
NI_INLINE float iq_scale() { return FMT == int(kIq3s) ? 281474976710656.0f : 35184372088832.0f; }  // 2^48 / 2^45

NI_INLINE void iq_load_x32(const device float* x, uint k0, thread float4* xv) {
  const device float4* xp = (const device float4*)(x + k0);
  _Pragma("clang loop unroll(full)")
  for (int i = 0; i < 8; ++i) xv[i] = xp[i];
}

NI_INLINE float iq_xsum(thread const float4* xv) {
  float4 s = xv[0];
  _Pragma("clang loop unroll(full)")
  for (int i = 1; i < 8; ++i) s += xv[i];
  return (s.x + s.y) + (s.z + s.w);
}

// The words of one sub-block (32 values from 32 j) of row r: fetched for all of a lane's rows first (their loads in
// flight together: with the loads next to their decode the kernels waited on memory, 30% of the ALU busy), then
// computed. IQ (FMT, sections s): c0.xy = Q, c0.z = X1 (IQ2_S qh | scales << 8, IQ3_S signs), c0.w = IQ3_S's
// qh | scale << 8, d; the result x 1 / iq_scale<FMT>(). Q8, an MLX 8-bit group-64 row (scales ws, biases wb): the 32
// codes in c0, c1, d = scale * 2^24, b = bias.
struct IqFetch {
  uint4 c0, c1;
  float d, b;
};

template <int FMT, bool Q8>
NI_INLINE IqFetch iq_fetch(const device uchar* W, const device bfloat* ws, const device bfloat* wb, IqSec s, uint r,
                           uint K, uint j) {
  IqFetch f;
  if (Q8) {
    const device uint4* p = (const device uint4*)((const device uint32_t*)W + size_t(r) * (K / 4) + j * 8);
    f.c0 = p[0];
    f.c1 = p[1];
    const uint g = r * (K / 64) + j / 2;
    f.d = float(ws[g]) * 16777216.0f;
    f.b = float(wb[g]);
  } else {
    const uint i = r * (K / 32) + j;
    const uint2 q = ((const device uint2*)W)[i];
    f.c0 = uint4(q, 0u, 0u);
    if (FMT == int(kIq2s)) f.c0.z = ((const device ushort*)(W + s.x1))[i];
    if (FMT == int(kIq3s)) {
      f.c0.z = ((const device uint*)(W + s.x1))[i];
      f.c0.w = iq3_e(W, s, i);
    }
    f.d = float(((const device half*)(W + s.d))[i / 8]);
  }
  return f;
}

template <int FMT, bool Q8>
NI_INLINE float iq_compute(IqFetch f, thread const float4* xv, float xs) {
  if (Q8) {  // codes as fp16 subnormals q 2^-24
    const uint cw[8] = {f.c0.x, f.c0.y, f.c0.z, f.c0.w, f.c1.x, f.c1.y, f.c1.z, f.c1.w};
    float d = 0.0f;
    _Pragma("clang loop unroll(full)")
    for (int i = 0; i < 8; ++i) {  // word i: values 4i .. 4i + 3 = xv[i]
      const half2 lo = as_type<half2>(cw[i] & 0x00FF00FFu), hi = as_type<half2>((cw[i] >> 8) & 0x00FF00FFu);
      d = fma(float(lo.x), xv[i].x, d);
      d = fma(float(hi.x), xv[i].y, d);
      d = fma(float(lo.y), xv[i].z, d);
      d = fma(float(hi.y), xv[i].w, d);
    }
    return fma(f.d, d, f.b * xs);
  }
  if (FMT == int(kIq2xxs)) return f.d * (nh_x2_sub(f.c0.y) * nh_x2_dot32(f.c0.xy, xv));
  if (FMT == int(kIq2s)) return f.d * iq2s_dot32(f.c0.xy, f.c0.z, xv);
  return f.d * iq3s_dot32(f.c0.xy, f.c0.z, f.c0.w, xv);
}

// Dot products of rows rr[j] (j < NR) of the NP matrices W[p] with x over K, reduced over the lanes that share them.
// Lanes (as nh_x2_rows, with the activations of a lane's sub-block loaded once for all its rows):
//  T = 0, K % 1024 == 0: lane l takes sub-blocks l, l + 32, ... of every row; acc[p][j] = row j's sum in every lane.
//  T = K / 32 (dividing 32; RS = 32 / T dividing NR): lane l takes sub-block l % T of rows l / T + RS i (i < NR / RS),
//    acc[p][i] = row (l / T + RS i)'s sum in the T lanes of its group (the routed down projection: K = I = 512, 16
//    lanes per row, 2 rows at a time).
//  T = 0, other K: the (row, sub-block) items of the NR rows spread over the lanes; acc[p][j] in every lane.
template <int FMT, int NR, int NP, bool Q8, int T>
NI_INLINE void iq_rows_dot(const device uchar* const thread* W, const device bfloat* const thread* ws,
                           const device bfloat* const thread* wb, IqSec s, thread const uint* rr, uint K,
                           const device float* x, uint lane, thread float (&acc)[NP][NR]) {
  _Pragma("clang loop unroll(full)")
  for (int p = 0; p < NP; ++p)
    _Pragma("clang loop unroll(full)")
    for (int j = 0; j < NR; ++j) acc[p][j] = 0.0f;
  if (T > 0) {
    constexpr int RS = T > 0 ? 32 / T : 1, NI = NR / RS;
    const uint j = lane % uint(T), ro = lane / uint(T);
    IqFetch f[NP][NI];
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int i = 0; i < NI; ++i) {
        uint r = rr[RS * i];  // row ro + RS i
        _Pragma("clang loop unroll(full)")
        for (int q = 1; q < RS; ++q)
          if (ro == uint(q)) r = rr[q + RS * i];
        f[p][i] = iq_fetch<FMT, Q8>(W[p], ws ? ws[p] : nullptr, wb ? wb[p] : nullptr, s, r, K, j);
      }
    float4 xv[8];
    iq_load_x32(x, j * 32, xv);
    const float xs = Q8 ? iq_xsum(xv) : 0.0f;
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int i = 0; i < NI; ++i) acc[p][i] = iq_compute<FMT, Q8>(f[p][i], xv, xs);
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int i = 0; i < NI; ++i)
        _Pragma("clang loop unroll(full)")
        for (uint o = 1; o < uint(T); o <<= 1) acc[p][i] += simd_shuffle_xor(acc[p][i], o);
    return;
  }
  const uint KF = K & ~1023u;
  for (uint k0 = lane * 32; k0 < KF; k0 += 1024) {
    IqFetch f[NP][NR];
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int j = 0; j < NR; ++j)
        f[p][j] = iq_fetch<FMT, Q8>(W[p], ws ? ws[p] : nullptr, wb ? wb[p] : nullptr, s, rr[j], K, k0 / 32);
    float4 xv[8];
    iq_load_x32(x, k0, xv);
    const float xs = Q8 ? iq_xsum(xv) : 0.0f;
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int j = 0; j < NR; ++j) acc[p][j] += iq_compute<FMT, Q8>(f[p][j], xv, xs);
  }
  if (KF < K) {
    const uint TT = (K - KF) / 32;
    for (uint t = lane; t < uint(NR) * TT; t += 32) {
      const uint jt = t / TT, j = KF / 32 + (t - jt * TT);
      float4 xv[8];
      iq_load_x32(x, j * 32, xv);
      const float xs = Q8 ? iq_xsum(xv) : 0.0f;
      uint r = rr[0];
      _Pragma("clang loop unroll(full)")
      for (int i = 1; i < NR; ++i)
        if (jt == uint(i)) r = rr[i];
      _Pragma("clang loop unroll(full)")
      for (int p = 0; p < NP; ++p) {
        const float v = iq_compute<FMT, Q8>(
            iq_fetch<FMT, Q8>(W[p], ws ? ws[p] : nullptr, wb ? wb[p] : nullptr, s, r, K, j), xv, xs);
        _Pragma("clang loop unroll(full)")
        for (int i = 0; i < NR; ++i) acc[p][i] += jt == uint(i) ? v : 0.0f;
      }
    }
  }
  _Pragma("clang loop unroll(full)")
  for (int p = 0; p < NP; ++p)
    _Pragma("clang loop unroll(full)")
    for (int j = 0; j < NR; ++j) acc[p][j] = simd_sum(acc[p][j]);
}

// ---- one or a few token rows: the per-row MoE (moeg_*_rows' layout) ----
struct MoeIqParams {
  uint D, I, SI, k;
  IqSec gu, dn;  // sections of the routed gate / up (one layout) and down matrices
};

// gate/up + SwiGLU: grid (ceil(max(I, SI) / (NR * simdgroups)), k + 1 slots, R rows); xn [R, D]; h [R, k + 1, Imax].
// Slot k is the shared expert (MLX 8-bit group 64), on grid row 0: its rows read 4x the routed experts' bytes, so they
// go first and the routed rows fill in around them (at the end of the grid they ran as a tail: 77 -> 66 us per layer).
// K = D % 1024 == 0.
template <int FG, int NR>
NI_INLINE void moei_gu_rows_impl(const device uchar* gw, const device uchar* uw, const device uint32_t* sgw,
                                 const device bfloat* sgs, const device bfloat* sgb, const device uint32_t* suw,
                                 const device bfloat* sus, const device bfloat* sub, const device float* xn,
                                 device float* h, constant MoeIqParams& p, const device uint* idx, uint3 tgp, uint sg,
                                 uint nsg, uint lane) {
  const uint slot = tgp.y == 0 ? p.k : tgp.y - 1, r = tgp.z;
  const bool shared = slot == p.k;
  const uint N = shared ? p.SI : p.I;
  const uint row0 = (tgp.x * nsg + sg) * NR;
  if (row0 >= N) return;
  float acc[2][NR];
  float sc;
  if (shared) {
    uint rr[NR];
    _Pragma("clang loop unroll(full)")
    for (int j = 0; j < NR; ++j) rr[j] = min(row0 + j, N - 1);
    const device uchar* W[2] = {(const device uchar*)sgw, (const device uchar*)suw};
    const device bfloat* S[2] = {sgs, sus};
    const device bfloat* B[2] = {sgb, sub};
    iq_rows_dot<0, NR, 2, true, 0>(W, S, B, p.gu, rr, p.D, xn + r * p.D, lane, acc);
    sc = 1.0f;
  } else {
    const uint e = idx[r * p.k + slot];
    uint rr[NR];
    _Pragma("clang loop unroll(full)")
    for (int j = 0; j < NR; ++j) rr[j] = e * N + min(row0 + j, N - 1);
    const device uchar* W[2] = {gw, uw};
    iq_rows_dot<FG, NR, 2, false, 0>(W, nullptr, nullptr, p.gu, rr, p.D, xn + r * p.D, lane, acc);
    sc = iq_scale<FG>();
  }
  const uint Imax = max(p.I, p.SI);
  if (lane == 0)
    _Pragma("clang loop unroll(full)")
    for (int j = 0; j < NR; ++j)
      if (row0 + j < N) h[(r * (p.k + 1) + slot) * Imax + row0 + j] = silu(acc[0][j] * sc) * (acc[1][j] * sc);
}

// down: x[r, n] += sum_slot wts[r, slot] * (down_slot[n] . h[r, slot]). One threadgroup per NR output rows and token row,
// one simdgroup per slot (k + 1 simdgroups; slot k the shared expert); the slots' sums go through threadgroup memory
// and are added in slot order. T = I / 32 when it divides 32 (the lanes of a row share its h, see iq_rows_dot), else 0
// (then I % 1024 == 0). grid (ceil(D / NR), R), 32 (k + 1) threads.
template <int FD, int NR, int T>
NI_INLINE void moei_down_rows_impl(const device uchar* dw, const device uint32_t* sdw, const device bfloat* sds,
                                   const device bfloat* sdb, const device float* h, const device uint* idx,
                                   const device float* wts, device float* x, constant MoeIqParams& p, uint2 tgp,
                                   uint sg, uint lane, threadgroup float* part) {
  constexpr int RS = T > 0 ? 32 / T : 1, NI = NR / RS;
  const uint r = tgp.y, slot = sg;
  const uint row0 = tgp.x * NR;
  const uint Imax = max(p.I, p.SI);
  if (slot <= p.k) {
    const device float* hs = h + (r * (p.k + 1) + slot) * Imax;
    float w = wts[r * (p.k + 1) + slot];
    float acc[1][NR];
    if (slot == p.k) {
      uint rr[NR];
      _Pragma("clang loop unroll(full)")
      for (int j = 0; j < NR; ++j) rr[j] = min(row0 + j, p.D - 1);
      const device uchar* W[1] = {(const device uchar*)sdw};
      const device bfloat* S[1] = {sds};
      const device bfloat* B[1] = {sdb};
      iq_rows_dot<0, NR, 1, true, T>(W, S, B, p.dn, rr, p.SI, hs, lane, acc);
    } else {
      const uint e = idx[r * p.k + slot];
      uint rr[NR];
      _Pragma("clang loop unroll(full)")
      for (int j = 0; j < NR; ++j) rr[j] = e * p.D + min(row0 + j, p.D - 1);
      const device uchar* W[1] = {dw};
      iq_rows_dot<FD, NR, 1, false, T>(W, nullptr, nullptr, p.dn, rr, p.I, hs, lane, acc);
      w *= iq_scale<FD>();
    }
    if (T > 0) {
      if (lane % uint(T == 0 ? 1 : T) == 0)
        _Pragma("clang loop unroll(full)")
        for (int i = 0; i < NI; ++i) part[slot * NR + lane / uint(T == 0 ? 1 : T) + RS * i] = w * acc[0][i];
    } else if (lane == 0) {
      _Pragma("clang loop unroll(full)")
      for (int j = 0; j < NR; ++j) part[slot * NR + j] = w * acc[0][j];
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg == 0 && lane < uint(NR) && row0 + lane < p.D) {
    float v = 0.0f;
    for (uint s2 = 0; s2 <= p.k; ++s2) v += part[s2 * NR + lane];
    x[r * p.D + row0 + lane] += v;
  }
}

#define NI_MOEI_GU_ROWS(NAME, FG, NR)                                                                          \
  [[kernel]] void NAME(const device uchar* gw [[buffer(0)]], const device uchar* uw [[buffer(1)]],            \
                       const device uint32_t* sgw [[buffer(2)]], const device bfloat* sgs [[buffer(3)]],       \
                       const device bfloat* sgb [[buffer(4)]], const device uint32_t* suw [[buffer(5)]],       \
                       const device bfloat* sus [[buffer(6)]], const device bfloat* sub [[buffer(7)]],         \
                       const device float* xn [[buffer(8)]], device float* h [[buffer(9)]],                    \
                       constant MoeIqParams& p [[buffer(10)]], const device uint* idx [[buffer(11)]],          \
                       uint3 tgp [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],  \
                       uint nsg [[simdgroups_per_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {     \
    moei_gu_rows_impl<FG, NR>(gw, uw, sgw, sgs, sgb, suw, sus, sub, xn, h, p, idx, tgp, sg, nsg, lane);         \
  }

#define NI_MOEI_DOWN_ROWS(NAME, FD, NR, T)                                                                     \
  [[kernel]] void NAME(const device uchar* dw [[buffer(0)]], const device uint32_t* sdw [[buffer(1)]],        \
                       const device bfloat* sds [[buffer(2)]], const device bfloat* sdb [[buffer(3)]],         \
                       const device float* h [[buffer(4)]], const device uint* idx [[buffer(5)]],              \
                       const device float* wts [[buffer(6)]], device float* x [[buffer(7)]],                   \
                       constant MoeIqParams& p [[buffer(8)]], uint2 tgp [[threadgroup_position_in_grid]],      \
                       uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {  \
    threadgroup float part[17 * NR];                                                                         \
    moei_down_rows_impl<FD, NR, T>(dw, sdw, sds, sdb, h, idx, wts, x, p, tgp, sg, lane, part);                \
  }

// ---- MMA operands ----
// The A operands of the 8 fragments for this lane's 16 values [v0, v0 + 16) of row r (v0 % 16 == 0): fragment f,
// k-slots (2c, 2c + 1) = values v0 + 8 (f / 4) + f % 4 and + 4 (the X8 table's order, and qmr's at BK = 64): the
// magnitudes times their sub-block's (2s + 1), x 2^-24, with their signs (exact halves); the value is that times d / 8
// (IQ2) or d (IQ3_S). The 16 values lie in one sub-block and one IQ2_S scale half.
template <int FMT>
NI_INLINE void iq_a16(const device uchar* W, IqSec s, uint r, uint nsb, uint v0, thread half2* a) {
  const uint j = v0 / 32, hb = (v0 / 16) & 1u;
  const uint i = r * nsb + j;
  const uint2 q = ((const device uint2*)W)[i];
  uint4 p0, p1;
  uint c;
  if (FMT == int(kIq2xxs)) {
    constant uint2* gt = (constant uint2*)iq2xxs_gridp;
    const uint sa = extract_bits(q.y, 14u * hb, 7), sb = extract_bits(q.y, 14u * hb + 7u, 7);
    p0 = iq_pairs(gt[extract_bits(q.x, 16u * hb, 8)], iq_s8(sa));
    p1 = iq_pairs(gt[extract_bits(q.x, 16u * hb + 8u, 8)], iq_s8(sb));
    c = (q.y >> 27) | 1u;
  } else if (FMT == int(kIq2s)) {
    constant uint2* gt = (constant uint2*)iq2s_gridp;
    const uint e = ((const device ushort*)(W + s.x1))[i];
    const uint qh = extract_bits(e, 4u * hb, 4);
    p0 = iq_pairs(gt[extract_bits(q.x, 16u * hb, 8) | ((qh & 3u) << 8)], extract_bits(q.y, 16u * hb, 8));
    p1 = iq_pairs(gt[extract_bits(q.x, 16u * hb + 8u, 8) | ((qh & 12u) << 6)], extract_bits(q.y, 16u * hb + 8u, 8));
    c = 2u * extract_bits(e, 8u + 4u * hb, 4) + 1u;
  } else {
    const uint sg = ((const device uint*)(W + s.x1))[i], e = iq3_e(W, s, i);
    const uint w = hb ? q.y : q.x, qh = extract_bits(e, 4u * hb, 4);
    const uint g0 = iq3s_grid[(w & 0xFFu) | ((qh << 8) & 256u)], g1 = iq3s_grid[extract_bits(w, 8, 8) | ((qh << 7) & 256u)];
    const uint g2 = iq3s_grid[extract_bits(w, 16, 8) | ((qh << 6) & 256u)], g3 = iq3s_grid[(w >> 24) | ((qh << 5) & 256u)];
    p0 = iq_pairs(iq3_T(g0, g1), extract_bits(sg, 16u * hb, 8));
    p1 = iq_pairs(iq3_T(g2, g3), extract_bits(sg, 16u * hb + 8u, 8));
    c = 2u * (e >> 8) + 1u;
  }
  const half2 hc = half2(half(c));
  a[0] = as_type<half2>(p0.x) * hc;
  a[1] = as_type<half2>(p0.y) * hc;
  a[2] = as_type<half2>(p0.z) * hc;
  a[3] = as_type<half2>(p0.w) * hc;
  a[4] = as_type<half2>(p1.x) * hc;
  a[5] = as_type<half2>(p1.y) * hc;
  a[6] = as_type<half2>(p1.z) * hc;
  a[7] = as_type<half2>(p1.w) * hc;
}

// The A operands of the 4 fragments for this lane's 8 values [v0, v0 + 8) of row r (v0 % 8 == 0; qmr's order at BK =
// 32: fragment f, k-slots (2c, 2c + 1) = values v0 + f and + 4), as iq_a16
template <int FMT>
NI_INLINE void iq_a8(const device uchar* W, IqSec s, uint r, uint nsb, uint v0, thread half2* a) {
  const uint j = v0 / 32, l = (v0 / 8) & 3u;  // sub-block, grid point (IQ3_S: the point pair 2l, 2l + 1)
  const uint i = r * nsb + j;
  const uint2 q = ((const device uint2*)W)[i];
  uint4 p0;
  uint c;
  if (FMT == int(kIq2xxs)) {
    constant uint2* gt = (constant uint2*)iq2xxs_gridp;
    p0 = iq_pairs(gt[extract_bits(q.x, 8u * l, 8)], iq_s8(extract_bits(q.y, 7u * l, 7)));
    c = (q.y >> 27) | 1u;
  } else if (FMT == int(kIq2s)) {
    constant uint2* gt = (constant uint2*)iq2s_gridp;
    const uint e = ((const device ushort*)(W + s.x1))[i];
    p0 = iq_pairs(gt[extract_bits(q.x, 8u * l, 8) | (extract_bits(e, 2u * l, 2) << 8)], extract_bits(q.y, 8u * l, 8));
    c = 2u * extract_bits(e, 8u + 4u * (l >> 1), 4) + 1u;
  } else {
    const uint sg = ((const device uint*)(W + s.x1))[i], e = iq3_e(W, s, i);
    const uint w = l < 2 ? q.x : q.y, sh = 16u * (l & 1u);
    const uint g0 = iq3s_grid[extract_bits(w, sh, 8) | (((e >> (2u * l)) & 1u) << 8)];
    const uint g1 = iq3s_grid[extract_bits(w, sh + 8u, 8) | (((e >> (2u * l + 1u)) & 1u) << 8)];
    p0 = iq_pairs(iq3_T(g0, g1), extract_bits(sg, 8u * l, 8));
    c = 2u * (e >> 8) + 1u;
  }
  const half2 hc = half2(half(c));
  a[0] = as_type<half2>(p0.x) * hc;
  a[1] = as_type<half2>(p0.y) * hc;
  a[2] = as_type<half2>(p0.z) * hc;
  a[3] = as_type<half2>(p0.w) * hc;
}

// d of 256-value block b of row r, times the factor that turns the MMA chain of iq_a16 operands into values
template <int FMT>
NI_INLINE float iq_dfac(const device uchar* W, IqSec s, uint r, uint nb, uint b) {
  return float(((const device half*)(W + s.d))[r * nb + b]) * (FMT == int(kIq3s) ? 16777216.0f : 2097152.0f);
}

// ---- the 8-row verify (verify8.metal's moe8 passes; moe8_plan's tiles, the shared expert as tile 0xffffffff) ----
struct Moe8IqParams {
  uint K, N, h_stride, hs_stride, k;
  IqSec sec;  // the routed matrices' sections (gate and up share them)
};

// acc[p] += A_p . X8 table over 64-groups [g0, g1) for NA operand rows: row r[p] of IQ matrix W[p] (this lane's row
// of an 8-row fragment), one fp32 chain per 256-value block (g0 % 4 == 0, g1 % 4 == 0)
template <int FMT, int NA>
NI_INLINE void iq8_run(const device uchar* const thread* W, IqSec s, thread const uint* r, uint K,
                       const device half* table, uint g0, uint g1, uint lane, uint q, thread float2* acc) {
  const uint nsb = K / 32, nb = K / 256;
  float2 ch[NA];
  _Pragma("clang loop unroll(full)")
  for (int p = 0; p < NA; ++p) ch[p] = float2(0.0f);
  for (uint g = g0; g < g1; ++g) {
    const device half4* tb = (const device half4*)(table + (g * 32 + lane) * 16);
    const half4 x0 = tb[0], x1 = tb[1], x2 = tb[2], x3 = tb[3];
    const half2 b[8] = {x0.xy, x0.zw, x1.xy, x1.zw, x2.xy, x2.zw, x3.xy, x3.zw};
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NA; ++p) {
      half2 a[8];
      iq_a16<FMT>(W[p], s, r[p], nsb, g * 64 + 16 * q, a);
      _Pragma("clang loop unroll(full)")
      for (int f = 0; f < 8; ++f) v8_mma(ch[p], a[f], b[f]);
    }
    if ((g & 3u) == 3u) {
      _Pragma("clang loop unroll(full)")
      for (int p = 0; p < NA; ++p) {
        acc[p] = fma(ch[p], float2(iq_dfac<FMT>(W[p], s, r[p], nb, g / 4)), acc[p]);
        ch[p] = float2(0.0f);
      }
    }
  }
}

// moe8i_gu: gate/up + SwiGLU of every touched expert's tile into its h table (as moe8g_gu: 8 column slices x KS
// k-slices of 64-column blocks; grid (N / 64, tiles), 256 KS threads)
template <int FG, int KS>
NI_INLINE void moe8i_gu_impl(const device uchar* Wg, const device uchar* Wu, const device uint32_t* SWg,
                             const device ushort* SSg, const device ushort* SBg, const device uint32_t* SWu,
                             const device ushort* SSu, const device ushort* SBu, const device half* table,
                             const device float* sums, device half* hT, device float* hS, constant Moe8IqParams& p,
                             const device uint* tiles, const device uint* ntiles, uint2 tg, uint sg, uint lane,
                             threadgroup float* red, threadgroup float2* kred) {
  constexpr uint NSG = 8;
  if (tg.y >= ntiles[0]) return;
  const uint e = tiles[tg.y];
  const bool shared = e == 0xffffffffu;
  const uint gpr = p.K / 64;
  const uint2 rc = v8_lane(lane);
  const uint fm = rc.x, fn = rc.y, q = fn / 2;
  const uint ci = sg / KS, kslice = sg % KS;
  const uint row = tg.x * 64 + ci * 8 + fm;
  const uint gper = (gpr + KS - 1) / KS, g0 = min(kslice * gper, gpr), g1 = min(g0 + gper, gpr);
  float2 acc[2] = {float2(0.0f), float2(0.0f)};
  if (shared) {
    const uint wpr = p.K / 4, spr = p.K / 64;
    const device uint32_t* wr[2] = {SWg + row * wpr, SWu + row * wpr};
    const device ushort* sr[2] = {SSg + row * spr, SSu + row * spr};
    const device ushort* br[2] = {SBg + row * spr, SBu + row * spr};
    v8g_run<8, 64, 2>(wr, sr, br, table, sums, g0, g1, lane, fn, q, acc);
  } else {
    const device uchar* W[2] = {Wg, Wu};
    const uint r[2] = {e * p.N + row, e * p.N + row};
    iq8_run<FG, 2>(W, p.sec, r, p.K, table, g0, g1, lane, q, acc);
  }
  if (KS > 1) v8_reduce<2>(acc, kred, KS, sg, lane);
  const bool lead = kslice == 0;
  device half* ht = hT + tg.y * p.h_stride;
  float2 ps = float2(0.0f);
  if (lead) {
    const uint kk = ci * 8 + fm;
    _Pragma("clang loop unroll(full)")
    for (int k2 = 0; k2 < 2; ++k2) {
      const half h = half(silu(acc[0][k2]) * acc[1][k2]);
      ht[v8_tab(tg.x, kk, fn + k2)] = h;
      ps[k2] += float(h);
    }
  }
  ps += simd_shuffle_xor(ps, 2u);
  ps += simd_shuffle_xor(ps, 4u);
  ps += simd_shuffle_xor(ps, 16u);
  if (lead && fm == 0) {
    red[ci * kV8 + fn] = ps.x;
    red[ci * kV8 + fn + 1] = ps.y;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg == 0 && lane < kV8) {
    float t = red[lane];
    for (uint i = 1; i < NSG; ++i) t += red[i * kV8 + lane];
    hS[tg.y * p.hs_stride + tg.x * kV8 + lane] = t;
  }
}

#define NI_MOE8I_GU(NAME, FG)                                                                                  \
  [[kernel]] void NAME(const device uchar* Wg [[buffer(0)]], const device uchar* Wu [[buffer(1)]],             \
                       const device uint32_t* SWg [[buffer(2)]], const device ushort* SSg [[buffer(3)]],        \
                       const device ushort* SBg [[buffer(4)]], const device uint32_t* SWu [[buffer(5)]],        \
                       const device ushort* SSu [[buffer(6)]], const device ushort* SBu [[buffer(7)]],          \
                       const device half* table [[buffer(8)]], const device float* sums [[buffer(9)]],          \
                       device half* hT [[buffer(10)]], device float* hS [[buffer(11)]],                         \
                       constant Moe8IqParams& p [[buffer(12)]], const device uint* tiles [[buffer(13)]],        \
                       const device uint* ntiles [[buffer(14)]], uint2 tg [[threadgroup_position_in_grid]],     \
                       uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {   \
    threadgroup float red[8 * kV8];                                                                            \
    threadgroup float2 kred[8 * 2 * 2 * 32];                                                                   \
    moe8i_gu_impl<FG, 2>(Wg, Wu, SWg, SSg, SBg, SWu, SSu, SBu, table, sums, hT, hS, p, tiles, ntiles, tg, sg, lane, \
                         red, kred);                                                                           \
  }

// moe8i_down: each tile's down projection to per (row, slot) outputs (as moe8g_down_nf2); grid (N / (8 NF simdgroups),
// tiles)
template <int FD, int NF>
NI_INLINE void moe8i_down_impl(const device uchar* W, const device uint32_t* SW, const device ushort* SS,
                               const device ushort* SB, const device half* hT, const device float* hS, device float* out,
                               device float* sh_out, constant Moe8IqParams& p, const device uint* tiles,
                               const device uint* ntiles, const device uint* slot, uint2 tg, uint sg, uint nsg,
                               uint lane) {
  if (tg.y >= ntiles[0]) return;
  const uint e = tiles[tg.y];
  const bool shared = e == 0xffffffffu;
  const uint gpr = p.K / 64;
  const uint2 rc = v8_lane(lane);
  const uint fm = rc.x, fn = rc.y, q = fn / 2;
  const uint n0 = (tg.x * nsg + sg) * 8 * NF;
  const device half* ht = hT + tg.y * p.h_stride;
  const device float* hs = hS + tg.y * p.hs_stride;
  float2 acc[NF];
  _Pragma("clang loop unroll(full)")
  for (int f = 0; f < NF; ++f) acc[f] = float2(0.0f);
  if (shared) {
    const uint wpr = p.K / 4, spr = p.K / 64;
    const device uint32_t* wr[NF];
    const device ushort* sr[NF];
    const device ushort* br[NF];
    _Pragma("clang loop unroll(full)")
    for (int f = 0; f < NF; ++f) {
      const uint row = n0 + 8 * f + fm;
      wr[f] = SW + row * wpr;
      sr[f] = SS + row * spr;
      br[f] = SB + row * spr;
    }
    v8g_run<8, 64, NF>(wr, sr, br, ht, hs, 0, gpr, lane, fn, q, acc);
  } else {
    const device uchar* Wf[NF];
    uint r[NF];
    _Pragma("clang loop unroll(full)")
    for (int f = 0; f < NF; ++f) {
      Wf[f] = W;
      r[f] = e * p.N + n0 + 8 * f + fm;
    }
    iq8_run<FD, NF>(Wf, p.sec, r, p.K, ht, 0, gpr, lane, q, acc);
  }
  _Pragma("clang loop unroll(full)")
  for (int e2 = 0; e2 < 2; ++e2) {
    const uint t = fn + e2, j = slot[tg.y * 8 + t];
    if (j == 0xffffffffu) continue;
    device float* o = shared ? sh_out + t * p.N : out + (t * p.k + j) * p.N;
    _Pragma("clang loop unroll(full)")
    for (int f = 0; f < NF; ++f) o[n0 + 8 * f + fm] = acc[f][e2];
  }
}

#define NI_MOE8I_DOWN(NAME, FD, NF)                                                                             \
  [[kernel]] void NAME(const device uchar* W [[buffer(0)]], const device uint32_t* SW [[buffer(1)]],             \
                       const device ushort* SS [[buffer(2)]], const device ushort* SB [[buffer(3)]],             \
                       const device half* hT [[buffer(4)]], const device float* hS [[buffer(5)]],                \
                       device float* out [[buffer(6)]], device float* sh_out [[buffer(7)]],                      \
                       constant Moe8IqParams& p [[buffer(8)]], const device uint* tiles [[buffer(9)]],           \
                       const device uint* ntiles [[buffer(10)]], const device uint* slot [[buffer(11)]],         \
                       uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],    \
                       uint nsg [[simdgroups_per_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {       \
    moe8i_down_impl<FD, NF>(W, SW, SS, SB, hT, hS, out, sh_out, p, tiles, ntiles, slot, tg, sg, nsg, lane);      \
  }

// ---- prefill: the qrm design (qmm_moe3.metal) on moe_bucket3's tiles with IQ weights ----
struct QrmIqParams {
  uint N, K, x_ld, y_ld;
  IqSec sec;
};

// acc[p*FA + a][b] = C_p[n = n0 + sgn*TN + 8a + rc.x][m = 8b + rc.y + e] over the whole K for the FL live row fragments
// of the tile (rows m0 .. m0 + rows of the sorted order). K steps of 64 (qmr's permuted X order at BK = 64: the lane's
// 16 values of a row per step are iq_a16's), one fp32 chain per 256-value block (4 steps), then acc += chain * d.
template <int FMT, int FL, int BN, int WN, int NP, int BK = 64>
NI_INLINE void qrmi_acc(const device half* X, const device uint* xrows, bool gather, uint x_ld, uint m0, uint rows,
                        const device uchar* const thread* W, IqSec s, uint rbase, uint N, uint K, uint n0,
                        threadgroup half* xs, uint tid, uint sgn, uint2 rc,
                        thread simdgroup_float8x8 (&acc)[NP * (BN / WN / 8)][FL]) {
  constexpr int NT = WN * 32, TN = BN / WN, FA = TN / 8, BMl = FL * 8, LD = BK + 8, NF = BK / 8;
  constexpr int CPR = BK / 8, XL = (BMl * CPR + NT - 1) / NT;
  const uint c = rc.y / 2, nsb = K / 32, nb = K / 256;
  simdgroup_float8x8 ch[NP * FA][FL];
  _Pragma("clang loop unroll(full)")
  for (int a = 0; a < NP * FA; ++a)
    _Pragma("clang loop unroll(full)")
    for (int b = 0; b < FL; ++b) acc[a][b] = ch[a][b] = simdgroup_float8x8(0);
  uint wrow[FA];
  _Pragma("clang loop unroll(full)")
  for (int a = 0; a < FA; ++a) wrow[a] = rbase + min(n0 + sgn * TN + a * 8 + rc.x, N - 1);
  uint xo[XL];
  qrm_xoff<BMl, BK, NT>(xrows, gather, x_ld / 8, m0, rows, tid, xo);
  const device uint4* X4 = (const device uint4*)X;
  uint4 xr[XL];
  for (uint k0 = 0; k0 < K; k0 += BK) {
    qrm_load_x<BMl, BK, NT>(X4, xo, k0, xr);
    half2 af[NP * FA][NF];
    _Pragma("clang loop unroll(full)")
    for (int p = 0; p < NP; ++p)
      _Pragma("clang loop unroll(full)")
      for (int a = 0; a < FA; ++a) {
        if (BK == 64) iq_a16<FMT>(W[p], s, wrow[a], nsb, k0 + 16 * c, af[p * FA + a]);
        else iq_a8<FMT>(W[p], s, wrow[a], nsb, k0 + 8 * c, af[p * FA + a]);
      }
    qr_store_x<BMl, BK, NT>(xs, tid, xr);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    _Pragma("clang loop unroll(full)")
    for (int f = 0; f < NF; ++f) {
      simdgroup_half8x8 A[NP * FA];
      _Pragma("clang loop unroll(full)")
      for (int i = 0; i < NP * FA; ++i) {
        A[i].thread_elements()[0] = af[i][f].x;
        A[i].thread_elements()[1] = af[i][f].y;
      }
      _Pragma("clang loop unroll(full)")
      for (int b = 0; b < FL; ++b) {
        simdgroup_half8x8 bf;
        simdgroup_load(bf, xs + (b * 8) * LD + 8 * f, LD, ulong2(0, 0), true);
        _Pragma("clang loop unroll(full)")
        for (int i = 0; i < NP * FA; ++i) simdgroup_multiply_accumulate(ch[i][b], A[i], bf, ch[i][b]);
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (((k0 + BK) & 255u) == 0) {
      _Pragma("clang loop unroll(full)")
      for (int p = 0; p < NP; ++p)
        _Pragma("clang loop unroll(full)")
        for (int a = 0; a < FA; ++a) {
          const int i = p * FA + a;
          const float df = iq_dfac<FMT>(W[p], s, wrow[a], nb, k0 / 256);
          _Pragma("clang loop unroll(full)")
          for (int b = 0; b < FL; ++b) {
            _Pragma("clang loop unroll(full)")
            for (int e = 0; e < 2; ++e)
              acc[i][b].thread_elements()[e] = fma(ch[i][b].thread_elements()[e], df, acc[i][b].thread_elements()[e]);
            ch[i][b] = simdgroup_float8x8(0);
          }
        }
    }
  }
}

template <int FMT, int FL, int BN, int WN, int BK = 64>
NI_INLINE void qrmi_gu_body(const device half* X, const device uint* xrows, uint x_ld, uint m0, uint rows,
                            const device uchar* const thread* W, IqSec s, uint rbase, device half* H, uint y_ld, uint N,
                            uint K, uint n0, threadgroup half* xs, uint tid, uint sgn, uint2 rc) {
  constexpr int TN = BN / WN, FA = TN / 8;
  simdgroup_float8x8 acc[2 * FA][FL];
  qrmi_acc<FMT, FL, BN, WN, 2, BK>(X, xrows, true, x_ld, m0, rows, W, s, rbase, N, K, n0, xs, tid, sgn, rc, acc);
  _Pragma("clang loop unroll(full)")
  for (int a = 0; a < FA; ++a) {
    const uint n = n0 + sgn * TN + a * 8 + rc.x;
    _Pragma("clang loop unroll(full)")
    for (int b = 0; b < FL; ++b)
      _Pragma("clang loop unroll(full)")
      for (int e = 0; e < 2; ++e) {
        const uint m = b * 8 + rc.y + e;
        const float g = acc[a][b].thread_elements()[e], u = acc[FA + a][b].thread_elements()[e];
        if (m < rows) H[(m0 + m) * y_ld + n] = half(silu(g) * u);
      }
  }
}

template <int FMT, int FL, int BN, int WN, int BK = 64>
NI_INLINE void qrmi_dn_body(const device half* X, uint x_ld, uint m0, uint rows, const device uchar* const thread* W,
                            IqSec s, uint rbase, device float* Y, const device uint* yrows, uint y_ld, uint N, uint K,
                            uint n0, threadgroup half* xs, uint tid, uint sgn, uint2 rc) {
  constexpr int TN = BN / WN, FA = TN / 8;
  simdgroup_float8x8 acc[FA][FL];
  qrmi_acc<FMT, FL, BN, WN, 1, BK>(X, nullptr, false, x_ld, m0, rows, W, s, rbase, N, K, n0, xs, tid, sgn, rc, acc);
  _Pragma("clang loop unroll(full)")
  for (int b = 0; b < FL; ++b)
    _Pragma("clang loop unroll(full)")
    for (int e = 0; e < 2; ++e) {
      const uint m = b * 8 + rc.y + e;
      if (m < rows) {
        device float* yr = Y + yrows[m0 + m] * y_ld + n0 + sgn * TN + rc.x;
        _Pragma("clang loop unroll(full)")
        for (int a = 0; a < FA; ++a) yr[a * 8] = acc[a][b].thread_elements()[e];
      }
    }
}

// gate/up + SwiGLU: H (sorted rows, half) from X rows gathered through xrows. grid (N / BN, max tiles), 32 WN threads.
#define NI_QRMI_GU(NAME, FMT, FB, BN, WN, BK)                                                                 \
  [[kernel, max_total_threads_per_threadgroup(WN * 32)]] void NAME(                                           \
      const device half* X [[buffer(0)]], const device uchar* Wg [[buffer(1)]], const device uchar* Wu [[buffer(2)]], \
      device half* H [[buffer(3)]], constant QrmIqParams& p [[buffer(4)]], const device uint* tiles [[buffer(5)]], \
      const device uint* ntiles [[buffer(6)]], const device uint* xrows [[buffer(7)]],                       \
      uint2 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],                    \
      uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {                  \
    if (tg.y >= ntiles[0]) return;                                                                           \
    threadgroup uint4 xs4[8 * FB * (BK + 8) / 8];                                                            \
    const uint e = tiles[tg.y * 3 + 0], m0 = tiles[tg.y * 3 + 1], rows = tiles[tg.y * 3 + 2] - m0;           \
    const device uchar* W[2] = {Wg, Wu};                                                                     \
    const uint n0 = tg.x * BN;                                                                               \
    const uint2 rc = qr_rc(lane);                                                                            \
    threadgroup half* xs = (threadgroup half*)xs4;                                                           \
    const uint live = (rows + 7) / 8;                                                                        \
    if (FB >= 4 && live >= 4)                                                                                \
      qrmi_gu_body<FMT, (FB >= 4 ? 4 : 1), BN, WN, BK>(X, xrows, p.x_ld, m0, rows, W, p.sec, e * p.N, H, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else if (FB >= 3 && live == 3)                                                                           \
      qrmi_gu_body<FMT, (FB >= 3 ? 3 : 1), BN, WN, BK>(X, xrows, p.x_ld, m0, rows, W, p.sec, e * p.N, H, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else if (FB >= 2 && live == 2)                                                                           \
      qrmi_gu_body<FMT, (FB >= 2 ? 2 : 1), BN, WN, BK>(X, xrows, p.x_ld, m0, rows, W, p.sec, e * p.N, H, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else                                                                                                     \
      qrmi_gu_body<FMT, 1, BN, WN, BK>(X, xrows, p.x_ld, m0, rows, W, p.sec, e * p.N, H, p.y_ld, p.N, p.K, n0, xs, \
                                       tid, sg, rc);                                                         \
  }

// down: Y[yrows[m]] (fp32 rows by pair id) = H[m] W_e^T. grid (N / BN, max tiles), 32 WN threads.
#define NI_QRMI_DN(NAME, FMT, FB, BN, WN, BK)                                                                 \
  [[kernel, max_total_threads_per_threadgroup(WN * 32)]] void NAME(                                           \
      const device half* X [[buffer(0)]], const device uchar* Wd [[buffer(1)]], device float* Y [[buffer(2)]],  \
      constant QrmIqParams& p [[buffer(3)]], const device uint* tiles [[buffer(4)]],                          \
      const device uint* ntiles [[buffer(5)]], const device uint* yrows [[buffer(6)]],                        \
      uint2 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],                    \
      uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {                  \
    if (tg.y >= ntiles[0]) return;                                                                           \
    threadgroup uint4 xs4[8 * FB * (BK + 8) / 8];                                                            \
    const uint e = tiles[tg.y * 3 + 0], m0 = tiles[tg.y * 3 + 1], rows = tiles[tg.y * 3 + 2] - m0;           \
    const device uchar* W[1] = {Wd};                                                                         \
    const uint n0 = tg.x * BN;                                                                               \
    const uint2 rc = qr_rc(lane);                                                                            \
    threadgroup half* xs = (threadgroup half*)xs4;                                                           \
    const uint live = (rows + 7) / 8;                                                                        \
    if (FB >= 4 && live >= 4)                                                                                \
      qrmi_dn_body<FMT, (FB >= 4 ? 4 : 1), BN, WN, BK>(X, p.x_ld, m0, rows, W, p.sec, e * p.N, Y, yrows, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else if (FB >= 3 && live == 3)                                                                           \
      qrmi_dn_body<FMT, (FB >= 3 ? 3 : 1), BN, WN, BK>(X, p.x_ld, m0, rows, W, p.sec, e * p.N, Y, yrows, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else if (FB >= 2 && live == 2)                                                                           \
      qrmi_dn_body<FMT, (FB >= 2 ? 2 : 1), BN, WN, BK>(X, p.x_ld, m0, rows, W, p.sec, e * p.N, Y, yrows, p.y_ld, \
                                                       p.N, p.K, n0, xs, tid, sg, rc);                      \
    else                                                                                                     \
      qrmi_dn_body<FMT, 1, BN, WN, BK>(X, p.x_ld, m0, rows, W, p.sec, e * p.N, Y, yrows, p.y_ld, p.N, p.K, n0, xs, \
                                       tid, sg, rc);                                                         \
  }

