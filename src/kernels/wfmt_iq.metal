// ---- decode helpers ----
struct IqSec {
  uint x1, x2, x3, d;  // byte offsets of the X1, X2, X3 and D sections
};

// IQ3_S: qh | scale << 8 of sub-block i (global index)
NI_INLINE uint iq3_e(const device uchar* W, IqSec s, uint i) {
  return uint(W[s.x2 + i]) | (extract_bits(uint(W[s.x3 + i / 2]), 4u * (i & 1u), 4) << 8);
}

// The 4 A pairs (e0, e4), (e1, e5), (e2, e6), (e3, e7) of one grid point, x 2^-24 with their signs: T = the magnitude
// bytes as (m0, m1, m4, m5), (m2, m3, m6, m7); s8 = the 8 signs (bit i: value i; bits past 7 are ignored).
NI_INLINE uint4 iq_pairs(uint2 T, uint s8) {
  // lo: s0 -> bit 15, s1 -> 23, s4 -> 31, s5 -> 7; hi: s2 -> 15, s3 -> 23, s6 -> 31, s7 -> 7 (one multiply each: the
  // shifted copies of the 4 bits only overlap at bits 27-28, whose carries stop at bit 29)
  const uint lo_m = ((s8 & 0x33u) * 0x08408004u) & 0x80808080u;
  const uint hi_m = (((s8 >> 2) & 0x33u) * 0x08408004u) & 0x80808080u;
  const uint lo = T.x ^ lo_m, hi = T.y ^ hi_m;
  const uint M = 0x807F807Fu;
  return uint4(lo & M, rotate(lo, 24u) & M, hi & M, rotate(hi, 24u) & M);
}

// IQ2_XXS's 8 signs: the 7 stored bits and their parity
NI_INLINE uint iq_s8(uint s7) { return s7 | (popcount(s7) << 7); }

// IQ3_S: two 4-value grid points (values 0-3, 4-7) as the permuted word pair
NI_INLINE uint2 iq3_T(uint g0, uint g1) { return uint2((g0 & 0xFFFFu) | (g1 << 16), (g0 >> 16) | (g1 & 0xFFFF0000u)); }

// d + the pairs (e_f, e_{f+4}) . (xa = x[0..3], xb = x[4..7])
NI_INLINE float iq_fma8p(uint4 p, float4 xa, float4 xb, float d) {
  const half2 w0 = as_type<half2>(p.x), w1 = as_type<half2>(p.y), w2 = as_type<half2>(p.z), w3 = as_type<half2>(p.w);
  d = fma(float(w0.x), xa.x, d);
  d = fma(float(w0.y), xb.x, d);
  d = fma(float(w1.x), xa.y, d);
  d = fma(float(w1.y), xb.y, d);
  d = fma(float(w2.x), xa.z, d);
  d = fma(float(w2.y), xb.z, d);
  d = fma(float(w3.x), xa.w, d);
  d = fma(float(w3.y), xb.w, d);
  return d;
}

// (2s + 1) 2^-24 (the subnormal half 2s + 1, as nh_x2_sub)
NI_INLINE float iq_sub(uint s) { return float(as_type<half>(ushort(2u * s + 1u))); }

