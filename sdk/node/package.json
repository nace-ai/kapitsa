{
  "name": "@kapitsa/sdk",
  "version": "0.1.0",
  "description": "Node.js and TypeScript bindings for Kapitsa's in-process C ABI",
  "type": "module",
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.js" } },
  "files": ["index.js", "index.d.ts", "README.md"],
  "engines": { "node": ">=22" },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "test": "node --test test/contract.test.js",
    "typecheck": "tsc --noEmit --strict --module NodeNext --target ES2022 test/types.ts",
    "test:gpu": "node --test test/model.test.js"
  },
  "dependencies": { "koffi": "3.3.5" },
  "devDependencies": { "typescript": "5.9.3" }
}
